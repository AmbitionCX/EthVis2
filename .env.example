# Fill these three connections. PostgreSQL uses a DSN, not an HTTP API.
TEKU_API=
POSTGRESQL_API=
CLICKHOUSE_API=
# Example formats:
# TEKU_API=http://127.0.0.1:5051
# POSTGRESQL_API=postgresql://user:password@127.0.0.1:5432/ethvis_control?sslmode=disable
# CLICKHOUSE_API=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=ethvis
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
ARCHIVE_DIR=./var/archive
RUNS_DIR=./var/runs
BLOCK_COUNT=100000
WORKERS=4
STATE_WORKERS=1
HTTP_TIMEOUT_SECONDS=180
HTTP_ATTEMPTS=4
BATCH_ROWS=20000
BATCH_BYTES=16777216
# Set true to additionally archive full epoch states (very large).
COLLECT_SSZ=false

# Number of explicit IDs per historical Validator request; checkpointed on disk.
VALIDATOR_BATCH_SIZE=500
