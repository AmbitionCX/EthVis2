# PostgreSQL is a DSN; ClickHouse is its HTTP interface, not native port 9000.
TEKU_API=http://127.0.0.1:5051
POSTGRESQL_API=postgresql://user:password@127.0.0.1:5432/ethvis_control?sslmode=disable
CLICKHOUSE_API=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=ethvis
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
ARCHIVE_DIR=./var/archive
RUNS_DIR=./var/runs
# Smoke test first; --blocks overrides this when planning a larger run.
BLOCK_COUNT=100
WORKERS=1
STATE_WORKERS=1
HTTP_TIMEOUT_SECONDS=7200
HTTP_ATTEMPTS=4
BATCH_ROWS=20000
BATCH_BYTES=16777216
# COLLECT_SSZ and VALIDATOR_BATCH_SIZE from v0.2 are unused in v0.3.
